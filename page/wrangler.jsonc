{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cargo-q",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "cargo-q.paulden.site", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
