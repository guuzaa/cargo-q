---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /**
   * The address this page is the one true page of. `false` for a page
   * that has no address of its own, such as the 404.
   */
  canonical?: string | false;
}

const { title, description, canonical = Astro.url } = Astro.props;
// Social cards need an absolute URL.
const image = new URL('/og.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090807" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/wasm/cargo-q.wasm" as="fetch" type="application/wasm" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical !== false && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="cargo-q: Run Cargo only once." />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical !== false && <link rel="canonical" href={canonical} />}
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink-800 focus:px-4 focus:py-2"
    >
      Skip to the content
    </a>
    <div class="backdrop" aria-hidden="true">
      <span class="ember ember-a"></span>
      <span class="ember ember-b"></span>
    </div>
    <slot />
    <script>
      import { copyButtons, reveal, spotlight } from '../scripts/motion';
      reveal();
      spotlight();
      copyButtons();
    </script>
  </body>
</html>
