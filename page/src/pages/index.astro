---
import Layout from '../layouts/Layout.astro';
import Agents from '../components/Agents.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Install from '../components/Install.astro';
import Nav from '../components/Nav.astro';
import Rule from '../components/Rule.astro';
import Semantics from '../components/Semantics.astro';
---

<Layout
  title="cargo-q — Run Cargo only once"
  description="Many Cargo commands, just one invocation. cargo-q runs them one after another, stops at the first failure, and exits with that command's own code."
>
  <Nav />

  <main id="main">
    <Hero />
    <Rule />
    <Semantics />
    <Features />
    <Agents />
    <Install />
  </main>

  <Footer />
</Layout>

<script>
  import '../scripts/copy';
  import '../scripts/latest-version';
  import '../scripts/console';
  import '../scripts/recording';
</script>
