---
const command = 'cargo install cargo-q --locked';
const links = [
  { href: 'https://github.com/guuzaa/cargo-q', label: 'github' },
  { href: 'https://crates.io/crates/cargo-q', label: 'crates.io' },
  { href: 'https://docs.rs/cargo-q', label: 'docs.rs' },
];
---

<section id="install" class="mx-auto max-w-3xl scroll-mt-24 px-4 pb-24 pt-32 text-center" aria-labelledby="install-title">
  <h2 id="install-title" class="text-xs uppercase tracking-[0.3em] text-sand-600" data-reveal>install</h2>

  <div class="card mx-auto mt-6 flex items-center gap-3 py-2 pl-5 pr-2 text-left sm:pl-7" data-glow data-reveal style="--i: 1">
    <span class="select-none text-rust-500" aria-hidden="true">$</span>
    <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-3 text-sm text-sand-50 sm:text-base">{command}</code>
    <button
      type="button"
      class="copy shrink-0 rounded-xl px-4 py-2.5 text-xs text-sand-300 transition-colors hover:bg-sand-50/5 hover:text-sand-50 active:scale-95"
      data-copy={command}
      aria-label="Copy the install command"
    >
      <span class="copy-idle">copy</span>
      <span class="copy-done">copied ✓</span>
    </button>
  </div>

  <p class="mt-4 text-xs text-sand-600" data-reveal style="--i: 2">
    Rust ≥ 1.75 · Linux · macOS · Windows · <span data-latest-version hidden></span>
  </p>

  <div class="mt-14 flex justify-center gap-2 text-sm" data-reveal style="--i: 3">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="group rounded-xl px-4 py-2 text-sand-500 transition-colors hover:bg-sand-50/5 hover:text-sand-50"
        >
          {link.label}
          <span class="inline-block transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
</section>

<footer class="border-t border-sand-50/5 py-8 text-center text-xs text-sand-600">
  Apache-2.0 · the parser on this page is cargo-q's own, in WebAssembly · cargo is simulated
</footer>
