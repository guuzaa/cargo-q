---
const links = [
  { href: 'https://github.com/guuzaa/cargo-q', label: 'GitHub' },
  { href: 'https://crates.io/crates/cargo-q', label: 'crates.io' },
  { href: 'https://docs.rs/cargo-q', label: 'docs.rs' },
];
---

<header class="sticky top-0 z-40 border-b border-ink-800/80 bg-ink-950/85 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3.5 text-sm"
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span class="text-rust-500">cargo</span><span class="-ml-2.5 text-sand-100">-q</span>
    </a>

    <div class="flex items-center gap-5 text-sand-300">
      {
        links.map((link) => (
          <a class="link" href={link.href} rel="noreferrer noopener" target="_blank">
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/guuzaa/cargo-q/blob/main/CHANGELOG.md"
        class="link hidden sm:inline"
        rel="noreferrer noopener"
        target="_blank"
      >
        Changelog
      </a>
    </div>
  </nav>
</header>
