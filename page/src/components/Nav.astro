---
const repo = 'https://github.com/guuzaa/cargo-q';
---

<header class="fixed inset-x-0 top-0 z-40">
  <nav
    class="mx-auto mt-3 flex max-w-5xl items-center justify-between rounded-2xl border border-sand-50/5 bg-ink-900/60 px-4 py-2.5 text-sm backdrop-blur-md"
    aria-label="Main"
  >
    <a href="/" class="group flex items-center gap-2.5 font-bold text-sand-50">
      <img src="/favicon.svg" alt="" width="26" height="26" class="transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110" />
      <span>cargo-q</span>
    </a>
    <div class="flex items-center gap-1 text-sand-500">
      <a href="#install" class="rounded-lg px-3 py-1.5 transition-colors hover:bg-sand-50/5 hover:text-sand-50">install</a>
      <a href="https://docs.rs/cargo-q" class="hidden rounded-lg px-3 py-1.5 transition-colors hover:bg-sand-50/5 hover:text-sand-50 sm:block">docs</a>
      <a href={repo} class="group flex items-center gap-1.5 rounded-lg px-3 py-1.5 transition-colors hover:bg-sand-50/5 hover:text-sand-50" aria-label="cargo-q on GitHub">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true" class="transition-transform duration-300 group-hover:rotate-[360deg]">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </div>
  </nav>
</header>
