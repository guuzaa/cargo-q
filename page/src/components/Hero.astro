---
/**
 * The title, the tagline, and the one line that says what cargo-q does.
 * The terminal that proves it sits right below, in `Terminal.astro`.
 */
import OneLine from './OneLine.astro';
---

<section id="main" class="relative mx-auto max-w-5xl px-4 pt-24 sm:pt-28">
  <div class="text-center">
    <h1 class="text-5xl font-extrabold tracking-tight text-sand-50 sm:text-7xl" data-reveal>
      cargo <span class="title-q">q</span><span class="caret" aria-hidden="true"></span>
    </h1>
    <p class="mt-4 text-base text-sand-300 sm:text-lg" data-reveal style="--i: 1">
      Run Cargo only once.
    </p>
    <OneLine />
  </div>
</section>
