---
/**
 * What cargo-q does, in one sentence and then in a few more, the way to
 * install it, and the one line that shows it. The name is in the nav; the
 * options come next, and the terminal that proves it waits further down,
 * in `Terminal.astro`.
 */
import OneLine from './OneLine.astro';

const command = 'cargo install cargo-q --locked';
---

<section id="main" class="relative mx-auto max-w-5xl px-4 pt-24 sm:pt-28">
  <div class="text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-balance text-sand-50 sm:text-6xl md:text-7xl" data-reveal>
      Run Cargo only <span class="title-q">once</span>.
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-sand-300 sm:text-base" data-reveal style="--i: 1">
      <span class="text-sand-50">cargo <span class="title-q">q</span></span> is a Cargo subcommand that runs several commands in one
      invocation, stops at the first failure, and exits with its code.
    </p>
    <div id="install" class="mt-8 flex scroll-mt-28 flex-wrap items-center justify-center gap-3" data-reveal style="--i: 2">
      <button
        type="button"
        class="copy card flex min-w-0 max-w-full items-center gap-3 py-3 pl-5 pr-4 text-left text-sm"
        data-copy={command}
        data-glow
        aria-label={`Copy the install command: ${command}`}
      >
        <span class="select-none text-rust-500" aria-hidden="true">$</span>
        <code class="min-w-0 overflow-x-auto whitespace-nowrap text-sand-50">{command}</code>
        <span class="shrink-0 text-sand-500" aria-hidden="true">
          <svg class="copy-idle" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.75"></rect>
            <path d="M10.75 5.25V3.5a1.25 1.25 0 0 0-1.25-1.25h-6A1.25 1.25 0 0 0 2.25 3.5v6a1.25 1.25 0 0 0 1.25 1.25h1.75"></path>
          </svg>
          <span class="copy-done">✓</span>
        </span>
      </button>
      <a
        href="https://docs.rs/cargo-q"
        class="group rounded-2xl px-4 py-3 text-sm text-sand-500 transition-colors hover:bg-sand-50/5 hover:text-sand-50"
      >
        docs.rs
        <span class="inline-block transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="mt-3 text-xs text-sand-600" data-reveal style="--i: 2.5">
      Rust ≥ 1.75 · Linux · macOS · Windows
    </p>
    <OneLine />
  </div>
</section>
