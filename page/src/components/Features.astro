---
const features = [
  {
    flag: '-n, --dry-run',
    title: 'See what would run',
    body: 'Print the commands an invocation means, without running any of them. A bare word can be read as a new command rather than an argument, so this is how you check before anything is spawned.',
  },
  {
    flag: '-v, --verbose',
    title: 'Watch each command',
    body: 'Stream a command’s output as it runs, the way cargo would on its own. The commands still run one after another.',
  },
  {
    flag: '-k, --keep-going',
    title: 'Run the rest anyway',
    body: 'Keep going after a failure instead of stopping at it. The exit code still reports the first failure.',
  },
  {
    flag: '--no-fancy',
    title: 'Plain output',
    body: 'One line per command and no color, even on a terminal. For a log file, a CI console, or an agent driving the build through a pipe.',
  },
  {
    flag: '--repeat <N>',
    title: 'The whole list, again',
    body: 'Run the list of commands N times over, in the order they were given. A failure ends the run, so the later rounds never start.',
  },
  {
    flag: '-p, --parallel',
    title: 'All at once (experimental)',
    body: 'Start the commands together instead of one after another. Commands that share a target directory lock each other out, so this is often no faster — and it is experimental.',
  },
];
---

<section id="features" class="border-b border-ink-800 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <h2 class="text-2xl font-bold tracking-tight text-sand-50 sm:text-3xl">Everything else it does</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-sand-300">
      The options of cargo-q come before the first command. After that, every word belongs to cargo.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="rounded-xl border border-ink-800 bg-ink-900 p-5 transition-colors hover:border-ink-700">
            <code class="text-xs text-rust-400">{feature.flag}</code>
            <h3 class="mt-2.5 font-semibold text-sand-50">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sand-300">{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
