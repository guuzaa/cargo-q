---
/**
 * The one-line promise: cargo commands folding into one. It sits in
 * the hero, under the tagline, and the terminal that proves it waits
 * further down the page, behind the flags.
 *
 * The chain is short enough for every screen: a wide one gets it in a
 * larger size, a narrow one in a smaller one.
 */
type Kind = 'program' | 'came' | 'command' | 'gone';
type Piece = [string, Kind];

const chain: Piece[] = [
  ['cargo', 'program'],
  [' q', 'came'],
  [' fmt', 'command'],
  [' && cargo', 'gone'],
  [' check', 'command'],
];

type Rendered = { text: string; kind: Kind; style?: string };
const render = (pieces: Piece[]): Rendered[] => {
  let gone = 0;
  return pieces.map(([text, kind]) =>
    kind === 'gone'
      ? { text, kind, style: `--w: ${text.length + 0.5}ch; --i: ${gone++}` }
      : { text, kind },
  );
};
const joined = (pieces: Piece[], skip: Kind) =>
  pieces
    .filter(([, kind]) => kind !== skip)
    .map(([text]) => text)
    .join('');

const rendered = render(chain);
const long = joined(chain, 'came');
const short = joined(chain, 'gone');

const variants = [
  { show: 'hidden md:block', size: 'text-[min(1.75rem,2.75vw)]' },
  { show: 'md:hidden', size: 'text-[min(1.4rem,6.2vw)]' },
];
---

<div class="mt-7 text-center sm:mt-9" data-reveal style="--i: 2">
  {
    variants.map((variant) => (
      <div class={`fold-scroll ${variant.show}`}>
        <div
          class="inline-block cursor-pointer transition hover:brightness-110"
          data-fold-card
          role="button"
          tabindex="0"
          title="Click to fold or unfold"
          aria-label={`${long} becomes ${short}. Fold or unfold it.`}
        >
          <div class={`fold font-medium ${variant.size}`} data-fold aria-hidden="true">{
            rendered.map((piece) =>
              piece.kind === 'gone' ? (
                <span class="gone" style={piece.style}>{piece.text}</span>
              ) : piece.kind === 'came' ? (
                <span class="came">{piece.text}</span>
              ) : (
                <span class={`r-${piece.kind}`}>{piece.text}</span>
              ),
            )
          }</div>
        </div>
      </div>
    ))
  }
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The fold takes a little over a second each way: the pieces collapse,
  // and `q` comes in a beat later.
  const FOLD_MS = 1300;

  // Every line on the page folds on its own: the wide one on a wide
  // screen, the narrow one on a phone.
  for (const card of document.querySelectorAll<HTMLElement>('[data-fold-card]')) {
    const fold = card.querySelector<HTMLElement>('[data-fold]');
    if (!fold) continue;

    const set = (folded: boolean) => {
      if (fold.hasAttribute('data-folded') === folded) return;
      fold.toggleAttribute('data-folded', folded);
    };

    // The line shows the trick twice: it folds, unfolds, and folds again,
    // then stays short. A click (or Enter/Space) folds or unfolds it.
    const timers: number[] = [];
    const later = (ms: number, run: () => void) => timers.push(window.setTimeout(run, ms));

    if (reduced) {
      later(0, () => set(true));
    } else {
      later(1000, () => set(true));
      later(1000 + FOLD_MS, () => set(false));
      later(1000 + FOLD_MS * 2, () => set(true));
    }

    // A hand on the card ends the show: the line stays as it is.
    const stop = () => {
      for (const timer of timers) window.clearTimeout(timer);
    };
    card.addEventListener('pointerdown', stop, { passive: true });
    card.addEventListener('keydown', stop);

    const toggle = () => set(!fold.hasAttribute('data-folded'));
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggle();
      }
    });
  }
</script>
